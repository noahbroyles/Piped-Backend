FROM ibm-semeru-runtimes:open-17-jdk AS build

WORKDIR /app/

COPY . /app/

RUN --mount=type=cache,target=/root/.gradle/caches/ \
 ./gradlew shadowJar

# The VERSION file is gitignored, so a clean checkout does not have one.
# Create it when it is missing, so that the COPY in the final stage does not fail (the backend reports unknown without it).
RUN test -f VERSION || echo unknown > VERSION

FROM ibm-semeru-runtimes:open-17-jre

WORKDIR /app/

COPY --from=build /app/build/libs/piped-1.0-all.jar /app/piped.jar

COPY --from=build /app/VERSION .

EXPOSE 8080

CMD java -server -Xmx1G -Xaggressive -XX:+UnlockExperimentalVMOptions -XX:+OptimizeStringConcat -XX:+UseStringDeduplication -XX:+UseCompressedOops -XX:+UseNUMA -XX:+IdleTuningGcOnIdle -Xgcpolicy:gencon -Xshareclasses:allowClasspaths -Xtune:virtualized -Xcompactgc -jar /app/piped.jar
